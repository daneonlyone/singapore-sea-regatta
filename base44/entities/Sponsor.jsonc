{
  "name": "Sponsor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "description": "Title Sponsor, Event Organiser, Official Partners, Corporate Sponsors, Fun Race Sponsors, Community Partners, Supporting Organisations, Other Sponsors"
    },
    "role": {
      "type": "string",
      "description": "Partner role label e.g. Audio Partner, VIP Hospitality, Champion Race Prize Sponsor"
    },
    "logo": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "tier"
  ]
}