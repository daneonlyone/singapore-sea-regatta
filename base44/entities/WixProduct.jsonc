{
  "name": "WixProduct",
  "type": "object",
  "properties": {
    "wix_id": {
      "type": "string",
      "description": "Wix product id"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Plain-text product description synced from Wix"
    },
    "price": {
      "type": "number"
    },
    "price_formatted": {
      "type": "string",
      "description": "e.g. $38.00"
    },
    "currency": {
      "type": "string"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "ribbon": {
      "type": "string",
      "description": "Wix ribbon label e.g. New Arrival"
    },
    "main_image": {
      "type": "string",
      "description": "Main product image URL"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All product image URLs"
    },
    "product_url": {
      "type": "string",
      "description": "Wix store product page URL"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "synced_at": {
      "type": "string",
      "description": "ISO timestamp of last sync"
    }
  },
  "required": [
    "wix_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}