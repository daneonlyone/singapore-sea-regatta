{
  "name": "Statistic",
  "type": "object",
  "properties": {
    "year": {
      "type": "string",
      "description": "Edition year e.g. 2024, 2025, 2026"
    },
    "label": {
      "type": "string",
      "description": "e.g. Athletes, Participating Teams, Community Partners, Festival Visitors"
    },
    "value": {
      "type": "number",
      "description": "Numeric value for animated counter"
    },
    "suffix": {
      "type": "string",
      "description": "e.g. + or K"
    },
    "is_placeholder": {
      "type": "boolean",
      "default": false,
      "description": "Marks as editable CMS placeholder"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "year",
    "label",
    "value"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}