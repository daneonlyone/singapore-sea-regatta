{
  "name": "SiteText",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique section key e.g. home_stats, goh_2026"
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "format": "file",
      "description": "Optional section image \u2014 upload to show, clear to remove"
    }
  },
  "required": [
    "key"
  ]
}