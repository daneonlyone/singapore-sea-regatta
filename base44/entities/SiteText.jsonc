{
  "name": "SiteText",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique section key e.g. home_stats, goh_2026"
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "format": "file",
      "description": "Optional section image \u2014 upload to show, clear to remove"
    },
    "image_focal_x": {
      "type": "number",
      "default": 0.5,
      "description": "Horizontal crop position 0 (left) to 1 (right)"
    },
    "image_focal_y": {
      "type": "number",
      "default": 0.5,
      "description": "Vertical crop position 0 (top) to 1 (bottom)"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}